# Read by src/services/api-client.ts. The screens still run on mock data, so
# nothing calls the API until an endpoint is wired.
#
# Key names only. Copy to .env.local and fill in. VITE_* values are compiled
# into the static bundle and readable by anyone — public values only.

# Base URL of the Accounts API. In production the API serves this app from the
# same origin, so leave it at the default "/api". For local development point
# it at the API dev server, e.g. http://localhost:4000/api (the API must allow
# this origin with credentials in its CORS config).
VITE_API_URL=/api

# Request timeout in milliseconds. Defaults to 60000 when unset or invalid.
VITE_API_TIMEOUT_MS=60000
