# Read by src/services/api-client.ts. Sign-in, users, sessions, the audit
# report and settings call the API; the other screens still run on mock data.
#
# Key names only. Copy to .env.local and fill in. VITE_* values are compiled
# into the static bundle and readable by anyone — public values only.

# Base URL of the Accounts API, including its APP_PREFIX. In production the
# API serves this app from the same origin, so leave it at the default "/v1".
# For local development point it at the API dev server, e.g.
# http://localhost:4100/v1. The API's APP_URL must be this app's origin
# (http://localhost:3001) so CORS allows it with credentials, and the session
# cookies need the same site (use localhost for both, not 127.0.0.1).
VITE_API_URL=/v1

# Request timeout in milliseconds. Defaults to 60000 when unset or invalid.
VITE_API_TIMEOUT_MS=60000
