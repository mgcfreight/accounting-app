# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# vite build output
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files — .env.example is the committed list of keys
.env*
!.env.example

# typescript
*.tsbuildinfo

# Claude Code — personal, not shared.
# .claude/rules, .claude/knowledge, .claude/hooks and .claude/settings.json
# ARE committed; these two are per-developer.
CLAUDE.local.md
.claude/settings.local.json
